 "structures": [
  {
   "id": "not-just",
   "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
   "name": "\"It's not just X, it's Y\"",
   "fix": "Di lo que de verdad quieres decir. Borra la mitad de preparación."
  },
  {
   "id": "not-only",
   "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
   "name": "\"Not only X but also Y\"",
   "fix": "Separa en dos oraciones o deja la mitad más fuerte."
  },
  {
   "id": "isnt-about",
   "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
   "name": "\"It isn't about X. It's about Y.\"",
   "fix": "Parte por Y. El giro es la marca."
  },
  {
   "id": "the-result",
   "regex": "(?im)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
   "name": "Pregunta retórica de una línea",
   "fix": "Responde en la misma oración en vez de montar una revelación."
  },
  {
   "id": "heres-what",
   "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
   "name": "\"Here's what I learned\"",
   "fix": "Escribe la lección. Omite el anuncio."
  },
  {
   "id": "triad",
   "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
   "name": "Tríada (regla de tres)",
   "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto de un modelo."
  },
  {
   "id": "rocket",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
   "name": "Emoji cohete, fuego, ampolleta, brillo o diana",
   "fix": "Un emoji como máximo, y que no sea de esos cinco."
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Muro de hashtags (5 o más)",
   "fix": "Tres hashtags como máximo."
  },
  {
   "id": "as-an-ai",
   "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
   "name": "Autorreferencia de modelo",
   "fix": "Borra la oración."
  },
  {
   "id": "in-summary",
   "regex": "(?im)^\\s*(?:in summary|to summarize|in conclusion)\\b",
   "name": "Apertura de cierre de ensayo",
   "fix": "Un post no necesita párrafo de conclusión."
  },
  {
   "id": "engagement-bait",
   "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
   "name": "Cebo de interacción reflejo",
   "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo específico que dijiste."
  }
 ]
}
