 "structures": [
  {
   "id": "not-just",
   "regex": "(?i)\\bno (?:es|son|fue|fueron) (?:solo|sólo|solamente|únicamente) [^.!?\\n]{2,60}[,.;]\\s*(?:es|son|fue|fueron|sino)\\b",
   "name": "\"No es solo X, es Y\"",
   "fix": "Di lo que de verdad quieres decir. Borra la mitad de preparación."
  },
  {
   "id": "not-only",
   "regex": "(?i)\\bno (?:solo|sólo|solamente) [^.!?\\n]{2,80}\\bsino (?:que )?también\\b",
   "name": "\"No solo X, sino también Y\"",
   "fix": "Separa en dos oraciones o deja la mitad más fuerte."
  },
  {
   "id": "isnt-about",
   "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}(?:,|\\.)\\s*(?:sino|se trata)\\b",
   "name": "\"No se trata de X, sino de Y\"",
   "fix": "Parte por Y. El giro es la marca."
  },
  {
   "id": "the-result",
   "regex": "(?im)^\\s*¿?(?:el resultado|la clave|lo mejor|el truco|el problema)\\?\\s*$",
   "name": "Pregunta retórica de una línea",
   "fix": "Responde en la misma oración en vez de montar una revelación."
  },
  {
   "id": "heres-what",
   "regex": "(?i)\\b(?:esto|eso|esta) es lo que (?:aprend(?:í|imos)|descubr(?:í|imos))\\b",
   "name": "\"Esto es lo que aprendí\"",
   "fix": "Escribe la lección. Omite el anuncio."
  },
  {
   "id": "triad",
   "regex": "(?i)\\b\\w+, \\w+ y \\w+\\.",
   "name": "Tríada (regla de tres)",
   "fix": "Revisa si la enumeración aporta contenido y precisión. Tres elementos son válidos cuando son los necesarios."
  },
  {
   "id": "rocket",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
   "name": "Emoji decorativo de cohete, fuego, ampolleta, brillo o diana",
   "fix": "Elimina los emojis decorativos."
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Muro de hashtags (5 o más)",
   "fix": "Tres hashtags como máximo."
  },
  {
   "id": "as-an-ai",
   "regex": "(?i)\\bcomo (?:un |una )?(?:modelo de lenguaje|ia)\\b",
   "name": "Autorreferencia de asistente",
   "fix": "Revísala en contexto. Conserva una declaración legítima de uso de IA o una explicación técnica; borra solo una autorreferencia accidental del asistente."
  },
  {
   "id": "in-summary",
   "regex": "(?im)^\\s*(?:en resumen|en conclusión|en definitiva|para concluir|para finalizar)\\b",
   "name": "Apertura de cierre de ensayo",
   "fix": "Un post no necesita párrafo de conclusión."
  },
  {
   "id": "engagement-bait",
   "regex": "(?i)¿(?:qué opinas|qué piensas|tú qué piensas|estás de acuerdo|quién más|me equivoco)\\?\\s*$",
   "name": "Cebo de interacción reflejo",
   "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo específico que dijiste."
  }
 ]
}
